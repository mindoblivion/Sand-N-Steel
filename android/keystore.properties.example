# Copy to android/keystore.properties and fill in with YOUR OWN keystore values.
# android/keystore.properties and any *.keystore / *.jks file are git-ignored.
# storeFile is resolved relative to android/app/, so the keystore belongs there.
storeFile=Sand-and-Steel.keystore
storePassword=the password from keystore.pass
keyAlias=the alias chosen when the keystore was created
keyPassword=usually the same as storePassword
